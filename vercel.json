{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "formhaus-final-multi-option": {
      "root": "Formhaus-FINAL-MULTI-OPTION",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "Formhaus-FINAL-MULTI-OPTION/backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "formhaus-final-multi-option"
      }
    }
  ]
}
